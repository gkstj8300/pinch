{
  "name": "pinch",
  "version": "0.1.0",
  "description": "PINCH - 핀치 (초단기 알바 매칭 플랫폼) 모노레포",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "api:dev": "pnpm --filter @pinch/api start:dev",
    "api:start": "pnpm --filter @pinch/api start",
    "api:build": "pnpm --filter @pinch/api build",
    "api:test": "pnpm --filter @pinch/api test",
    "api:lint": "pnpm --filter @pinch/api lint",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @pinch/api db:migrate",
    "db:seed": "pnpm --filter @pinch/api db:seed",
    "db:reset": "pnpm --filter @pinch/api db:reset",
    "db:studio": "pnpm --filter @pinch/api db:studio",
    "stress": "k6 run k6/apply-stress.js"
  }
}
