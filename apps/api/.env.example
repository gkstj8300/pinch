# PostgreSQL
DATABASE_URL=postgresql://pinch:pinch@localhost:5433/pinch_dev?schema=public

# App
PORT=3000
NODE_ENV=development

# JWT (Slice 2 mock auth — Slice 3 에서 NICE/다날 OTP 로 교체)
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=1d

# QR (TOTP)
QR_SECRET=change-me-in-production-min-32-chars

# Kakao OAuth (개발용 placeholder — 실제 키는 .env에만)
KAKAO_REST_API_KEY=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=
# Expo Go 환경에서는 https://auth.expo.io/@<expo-username>/pinch-mobile
# Standalone(EAS) 빌드 시 pinch://oauth/kakao
KAKAO_REDIRECT_URI=https://auth.expo.io/@your-username/pinch-mobile

# (추후 Slice 3 이후)
# NICE_API_KEY=
# DANAL_API_KEY=
# PORTONE_API_KEY=
