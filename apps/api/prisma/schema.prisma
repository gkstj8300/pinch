// =====================================================
// PINCH - Slice 2 스키마 (출퇴근 + 정산 + 리뷰)
// 범위:
//   - User: 본인인증·핀치스코어 구성요소 확장 (Slice 3 NICE/다날 연동 전제 필드 미리 마련)
//   - Match: check-in/out 시각, GPS 인증, 정산 스냅샷(3.3% 원천세)
//   - Wallet / Transaction: append-only ledger 패턴
//   - Review: 양방향 평가
// =====================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum UserRole {
  WORKER
  CLIENT
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MatchStatus {
  PENDING
  MATCHED
  CHECKED_IN
  CHECKED_OUT
  COMPLETED
  NOSHOW
  CANCELLED
}

enum TransactionType {
  EARNING       // 업무 완료 적립 (세전)
  WITHHOLDING   // 3.3% 원천세 차감 (음수 netAmount)
  WITHDRAWAL    // 본인 계좌 출금
  REFUND
  ADJUSTMENT
  PENALTY
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id                    BigInt              @id @default(autoincrement())

  // ── 인증 (이메일+비밀번호 / OAuth) ──
  email                 String              @unique @db.VarChar(255)
  passwordHash          String?             @map("password_hash") @db.VarChar(255)
  oauthProvider         String?             @map("oauth_provider") @db.VarChar(20)
  oauthId               String?             @map("oauth_id") @db.VarChar(100)

  // ── 프로필 ──
  name                  String              @db.VarChar(50)
  profileImg            String?             @map("profile_img")
  role                  UserRole

  // ── 본인인증 (Slice 3 에서 NICE/다날 응답 채움) ──
  isVerified            Boolean             @default(false) @map("is_verified")
  verificationStatus    VerificationStatus  @default(UNVERIFIED) @map("verification_status")
  ciHash                String?             @unique @map("ci_hash") @db.Char(88)
  diHash                String?             @map("di_hash") @db.Char(88)
  verifiedAt            DateTime?           @map("verified_at") @db.Timestamptz(6)

  // ── 약관/마케팅 동의 ──
  termsAgreedAt         DateTime?           @map("terms_agreed_at") @db.Timestamptz(6)
  marketingConsentedAt  DateTime?           @map("marketing_consented_at") @db.Timestamptz(6)

  // ── 핀치 스코어 구성 요소 ──
  pinchScore            Int                 @default(1000) @map("pinch_score")
  ratingAvg             Decimal             @default(0) @db.Decimal(3, 2) @map("rating_avg")
  totalReviews          Int                 @default(0) @map("total_reviews")
  completedCount        Int                 @default(0) @map("completed_count")
  noshowCount           Int                 @default(0) @map("noshow_count")
  lateCount             Int                 @default(0) @map("late_count")
  cancelCount           Int                 @default(0) @map("cancel_count")

  // ── 관계 ──
  jobsCreated           Job[]               @relation("ClientJobs")
  matches               Match[]             @relation("WorkerMatches")
  wallet                Wallet?
  reviewsWritten        Review[]            @relation("ReviewWriter")
  reviewsReceived       Review[]            @relation("ReviewTarget")
  refreshTokens         RefreshToken[]

  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?           @map("deleted_at") @db.Timestamptz(6)

  @@unique([oauthProvider, oauthId], map: "users_oauth_key")
  @@index([role, deletedAt])
  @@index([pinchScore(sort: Desc)])
  @@map("users")
}

model Job {
  id               BigInt    @id @default(autoincrement())
  clientId         BigInt    @map("client_id")

  title            String    @db.VarChar(120)
  description      String    @db.Text
  category         String    @db.VarChar(40)

  address          String    @db.VarChar(255)
  latitude         Decimal   @db.Decimal(10, 7)
  longitude        Decimal   @db.Decimal(10, 7)
  // PostGIS Point — 트리거로 lat/lng와 동기화 (migration SQL에서 정의)
  location         Unsupported("geography(Point, 4326)")?

  startAt          DateTime  @map("start_at") @db.Timestamptz(6)
  endAt            DateTime  @map("end_at") @db.Timestamptz(6)
  hourlyWage       Int       @map("hourly_wage")
  estimatedMinutes Int       @map("estimated_minutes")

  recruitCount     Int       @map("recruit_count")
  confirmedCount   Int       @default(0) @map("confirmed_count")

  minPinchScore    Int       @default(0) @map("min_pinch_score")
  requireVerified  Boolean   @default(true) @map("require_verified")
  checkInRadiusM   Int       @default(150) @map("check_in_radius_m")

  status           JobStatus @default(OPEN)

  client           User      @relation("ClientJobs", fields: [clientId], references: [id])
  matches          Match[]

  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([status, startAt, deletedAt])
  @@index([clientId, deletedAt])
  @@index([category, status, startAt])
  @@index([latitude, longitude])
  @@map("jobs")
}

model Match {
  id              BigInt        @id @default(autoincrement())
  jobId           BigInt        @map("job_id")
  workerId        BigInt        @map("worker_id")

  status          MatchStatus   @default(PENDING)

  // ── 라이프사이클 ──
  appliedAt       DateTime      @default(now()) @map("applied_at") @db.Timestamptz(6)
  matchedAt       DateTime?     @map("matched_at") @db.Timestamptz(6)
  checkInAt       DateTime?     @map("check_in_at") @db.Timestamptz(6)
  checkOutAt      DateTime?     @map("check_out_at") @db.Timestamptz(6)
  completedAt     DateTime?     @map("completed_at") @db.Timestamptz(6)
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  cancelReason    String?       @map("cancel_reason") @db.VarChar(255)

  // ── GPS 인증 (audit) ──
  checkInLat      Decimal?      @db.Decimal(10, 7) @map("check_in_lat")
  checkInLng      Decimal?      @db.Decimal(10, 7) @map("check_in_lng")
  checkInDistance Int?          @map("check_in_distance_m")
  qrToken         String?       @map("qr_token") @db.VarChar(64)

  // ── 정산 스냅샷 (3.3% 원천세) ──
  workedMinutes   Int?          @map("worked_minutes")
  grossAmount     Int?          @map("gross_amount")
  withholdingTax  Int?          @map("withholding_tax")
  netAmount       Int?          @map("net_amount")

  job             Job           @relation(fields: [jobId], references: [id])
  worker          User          @relation("WorkerMatches", fields: [workerId], references: [id])
  transactions    Transaction[]
  reviews         Review[]

  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)

  @@unique([jobId, workerId])
  @@index([workerId, status])
  @@index([jobId, status])
  @@map("matches")
}

model Wallet {
  id              BigInt        @id @default(autoincrement())
  userId          BigInt        @unique @map("user_id")

  // 모든 금액은 원 단위 정수
  balance         Int           @default(0)                          // 출금 가능 잔액
  pendingAmount   Int           @default(0) @map("pending_amount")   // 정산 대기액
  totalEarned     Int           @default(0) @map("total_earned")     // 누적 세전 수입
  totalWithheld   Int           @default(0) @map("total_withheld")   // 누적 원천세
  totalWithdrawn  Int           @default(0) @map("total_withdrawn")  // 누적 출금

  // Slice 3 에서 PortOne 실명 확인 후 채움 (pgcrypto 암호화 권장)
  bankCode        String?       @map("bank_code") @db.VarChar(10)
  bankAccountEnc  String?       @map("bank_account_enc") @db.Text

  user            User          @relation(fields: [userId], references: [id])
  transactions    Transaction[]

  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)

  @@map("wallets")
}

model Transaction {
  id              BigInt              @id @default(autoincrement())
  walletId        BigInt              @map("wallet_id")
  matchId         BigInt?             @map("match_id")

  type            TransactionType
  status          TransactionStatus   @default(PENDING)

  grossAmount     Int                 @map("gross_amount")
  withholdingTax  Int                 @default(0) @map("withholding_tax")
  netAmount       Int                 @map("net_amount")

  // Append-only ledger audit
  balanceBefore   Int                 @map("balance_before")
  balanceAfter    Int                 @map("balance_after")

  description     String?             @db.VarChar(255)
  externalRef     String?             @map("external_ref") @db.VarChar(100) // PG 거래번호
  idempotencyKey  String?             @unique @map("idempotency_key") @db.VarChar(100)

  processedAt     DateTime?           @map("processed_at") @db.Timestamptz(6)

  wallet          Wallet              @relation(fields: [walletId], references: [id])
  match           Match?              @relation(fields: [matchId], references: [id])

  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamptz(6)

  @@index([walletId, createdAt(sort: Desc)])
  @@index([type, status])
  @@index([matchId])
  @@index([externalRef])
  @@map("transactions")
}

model Review {
  id         BigInt    @id @default(autoincrement())
  matchId    BigInt    @map("match_id")
  writerId   BigInt    @map("writer_id")
  targetId   BigInt    @map("target_id")

  score      Int       // 1~5 (CHECK 제약: post-init.sql)
  comment    String?   @db.Text

  match      Match     @relation(fields: [matchId], references: [id])
  writer     User      @relation("ReviewWriter", fields: [writerId], references: [id])
  target     User      @relation("ReviewTarget", fields: [targetId], references: [id])

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([matchId, writerId])
  @@index([targetId, deletedAt])
  @@map("reviews")
}

// =====================================================
// RefreshToken — JWT 회전(rotation) 추적
//
//   - 매 /auth/refresh 마다 새 record 생성 + 이전은 revoked_at 채움
//   - parent_id 로 회전 체인 추적 (감사용)
//   - reuse 감지: 이미 revoked 된 토큰이 재사용되면 해당 user 의 모든
//     활성 refresh 를 일괄 revoke (탈취 의심 — 강제 로그아웃)
//   - token_hash 만 저장. raw token 은 클라이언트만 보유 (bcrypt cost=10 → 60자)
//   - 조회 키는 JWT payload 의 tid 로 단일 row 만 fetch → O(1) bcrypt 1회
// =====================================================
model RefreshToken {
  id            BigInt    @id @default(autoincrement())
  userId        BigInt    @map("user_id")
  tokenHash     String    @map("token_hash") @db.Char(60)
  issuedAt      DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  rotatedAt     DateTime? @map("rotated_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason  String?   @map("revoke_reason") @db.VarChar(40)
  parentId      BigInt?   @map("parent_id")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent        RefreshToken?  @relation("RefreshTokenChain", fields: [parentId], references: [id])
  children      RefreshToken[] @relation("RefreshTokenChain")

  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, revokedAt, expiresAt])
  @@index([parentId])
  @@map("refresh_tokens")
}
