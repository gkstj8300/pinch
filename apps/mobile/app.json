{
  "expo": {
    "name": "PINCH",
    "slug": "pinch-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "../../packages/brand-assets/favicon/web-app-manifest-512x512.png",
    "scheme": "pinch",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kr.pinch.mobile"
    },
    "android": {
      "package": "kr.pinch.mobile",
      "adaptiveIcon": {
        "foregroundImage": "../../packages/brand-assets/favicon/web-app-manifest-512x512.png",
        "backgroundColor": "#fdfdfd"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "../../packages/brand-assets/favicon/favicon-96x96.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "../../packages/brand-assets/logo/logo.png",
          "backgroundColor": "#FDFDFD",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
