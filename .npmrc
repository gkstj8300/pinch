# Expo + pnpm 모노레포 호환 설정
#
# 이유: Expo/Metro 가 일부 transitive 의존성 (@babel/runtime,
# react-native-css-interop/jsx-runtime 등) 을 평면 node_modules 에서
# 찾는다. pnpm 의 기본 isolated 구조에서는 해당 위치에 없어 번들 실패.
#
# node-linker=hoisted: npm 방식의 평면 node_modules 구조로 풀어놓음.
#   pnpm 의 .pnpm/ 가상 저장소 + 심링크 모델 대신 직접 복사/링크.
#   trade-off: 디스크 약간 비효율적이나 RN/Expo 호환성 100% 확보.
node-linker=hoisted
